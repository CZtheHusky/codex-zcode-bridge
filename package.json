{
  "name": "codex-zcode-bridge",
  "version": "1.2.7",
  "private": true,
  "description": "Coding Agent Bridge：委派、跟进并验收本机 ZCode / Kimi 编码任务，支持模型选择及受环境限制的预约唤醒。",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./core": {
      "types": "./dist/src/core.d.ts",
      "import": "./dist/src/core.js"
    }
  },
  "files": [
    "dist/src",
    "docs/SHARED_CORE.md",
    "docs/ARCHITECTURE.md",
    "docs/INTERFACES.md",
    "docs/ZCODE_RUNTIME.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:plugin",
    "build:test": "tsc --project tsconfig.test.json",
    "build:core": "node scripts/build-core.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node scripts/test-isolated.mjs",
    "test:clean-entrypoints": "npm run build:test && node scripts/test-clean-entrypoints.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "bridge:mcp": "node dist/src/mcp/main.js"
  },
  "bin": {
    "zcode-bridge-mcp": "dist/src/mcp/main.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "playwright-core": "1.64.0",
    "zod": "^4.6.5"
  }
}
